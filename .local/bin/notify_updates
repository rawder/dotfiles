#!/bin/bash
while true; do
	# Commands to be executed repeatedly
	updates=$(checkupdates | wc -l)
	if [ "$updates" -gt 0 ]; then
		notify-send --icon="/usr/share/icons/Papirus/32x32/apps/system-software-update.svg" \
			"Arch Linux Updates" "$updates packages available for update"
	fi
	sleep 1h
done
